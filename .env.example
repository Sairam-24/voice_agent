# Copy to .env and edit. Every value below is the built-in default except the secret,
# which is intentionally empty. Never commit .env.

# --- app ---
# Empty = serve the React build (frontend/dist) if it exists, otherwise the plain page in web/.
# Set it to serve exactly one folder (for example WEB_DIR=web for the plain page only).
WEB_DIR=
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | text
WARMUP_ON_START=true       # false = measure true cold-start latency

# --- local or cloud ---
# auto (default) = Gemini when a Gemini API key is available, the local model otherwise: with no key
# the app runs fully locally. The key is GEMINI_API_KEY below, or one a user enters in the browser
# (System page), used for that user's questions only. whisper / ollama / local keep a stage local.

# --- speech-to-text ---
# Gemini transcribes many languages well (audio goes to Google); local Whisper is the fallback.
STT_PROVIDER=auto          # auto | whisper
GEMINI_STT_MODEL=gemini-3.5-flash-lite
STT_FALLBACK_TO_WHISPER=true
STT_MODEL=base.en          # tiny.en | base.en | small.en (English); base | small (multilingual)
STT_MODEL_DIR=models/whisper
STT_DEVICE=cpu             # cpu | cuda (see README: GPU notes)
STT_COMPUTE_TYPE=int8      # int8 on CPU; float16 on GPU
STT_CPU_THREADS=0          # 0 = library default
STT_BEAM_SIZE=1
STT_VAD_FILTER=true
STT_LANGUAGE=en            # a language code, or auto (needs a multilingual STT_MODEL)
# With auto: the languages you speak, e.g. te,en. Stops Telugu being written as Hindi.
STT_LANGUAGES=

# --- language model ---
LLM_PROVIDER=auto          # auto | ollama
LLM_FALLBACK_TO_OLLAMA=true   # the local model answers when Gemini refuses (quota, bad key)
LLM_MAX_OUTPUT_TOKENS=160
LLM_TEMPERATURE=0.6

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_KEEP_ALIVE=30m
# CPU threads for generation. Empty = Ollama's default (all physical cores). Fewer threads leave
# cores for speech-to-text and text-to-speech but slow down token generation.
OLLAMA_NUM_THREAD=

# Optional: the server's key, used for everyone who has not entered their own. Leave it empty on a
# public server unless you want visitors to use your quota. Free keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: minimal | low | medium | high. Leave empty to use the model's default.
GEMINI_THINKING_LEVEL=

# --- text-to-speech ---
# With a key: the natural Gemini voice (free tier: very few requests per day; see README), with the
# local voices as the fallback. Without one: the local voices.
TTS_PROVIDER=auto          # auto | local
# One model, or several separated by commas: each has its own free daily quota, and the next is
# used when one is used up (see README for which ones a free key could use).
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore      # Puck, Charon, Aoede, Fenrir, Leda, ... (30 voices)
TTS_FALLBACK_TO_LOCAL=true
# Local voices, one per script. English: piper (fast) or kokoro (natural, about real time on a
# 2-core CPU). Telugu: a Piper voice such as te_IN-padmavathi-medium; empty = none.
TTS_LOCAL_ENGLISH=piper
TTS_VOICE=en_US-ljspeech-medium   # the Piper English voice
KOKORO_VOICE=af_heart
TTS_TELUGU_VOICE=
TTS_MODEL_DIR=models/piper
# Streaming only. 0 = speak whole sentences. N > 0 = the first spoken chunk may end at a comma
# once N characters exist, so a long first sentence does not delay the first sound.
TTS_FIRST_CLAUSE_CHARS=0

# --- concurrency / backpressure ---
STT_CONCURRENCY=1
LLM_CONCURRENCY=1
TTS_CONCURRENCY=1
MAX_INFLIGHT_TURNS=4

# --- timeouts (seconds) ---
STT_TIMEOUT_S=30
LLM_FIRST_TOKEN_TIMEOUT_S=30
LLM_TIMEOUT_S=60
TTS_TIMEOUT_S=30
TURN_TIMEOUT_S=120

# --- WebSocket ---
# Re-transcribes the audio recorded so far every PARTIAL_INTERVAL_S and shows it live.
# Each partial is a full Whisper run, so on a small CPU it can slow the final transcript.
PARTIAL_TRANSCRIPTS=false
PARTIAL_INTERVAL_S=2.0
# Extra allowed browser origins for the WebSocket (comma-separated). Same-origin is always allowed.
ALLOWED_ORIGINS=

# --- measured low-latency profile (optional) ---
# On the 2-core development laptop this lowered time to first audio in every round of a rotating
# comparison (see README, "Comparing settings fairly"). It trades things the benchmark could not
# measure: tiny.en is less accurate on real speech, and a first chunk that ends at a comma can sound
# less natural. To try it, set these three values above instead of the defaults:
#   STT_MODEL=tiny.en
#   STT_CPU_THREADS=2
#   TTS_FIRST_CLAUSE_CHARS=40
# (tiny.en is downloaded on first start, or run scripts/download_models.py with STT_MODEL=tiny.en set)

# --- input limits ---
MAX_AUDIO_SECONDS=30
MAX_UPLOAD_BYTES=10000000
MAX_HISTORY_TURNS=6

# --- attached files (ask questions about a PDF, .docx or text file) ---
MAX_DOCUMENT_BYTES=10000000
# Characters of the files' text per prompt. Empty = 16000 with Gemini, 3000 with Ollama.
DOCUMENT_CONTEXT_CHARS=
